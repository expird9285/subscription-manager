{
  "name": "subscription-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local-upstream localhost:8787",
    "build:css": "tailwindcss -i ./src/styles/app.css -o ./public/assets/app.css --minify",
    "deploy": "npm run db:migrate:remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "export:supabase": "node scripts/export-supabase.mjs",
    "cf-typegen": "wrangler types --strict-vars=false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "hono": "^4.13.10"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^22.0.0",
    "lucide": "^1.48.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "~4.1.11",
    "wrangler": "^4.143.0"
  }
}
