[Unit]
Description=Subscription Manager Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/subscription-assistant
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/subscription-assistant/.venv/bin/python -m bot.main
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
